<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The instances, then Project Zomboid news below them; one scroll for both. The instance
         list is short, so it is laid out in full instead of recycling. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/launcher_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/game_instances_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- First steps for a player who opens the launcher knowing nothing: shown only while there is
                 no instance, with a way into the wiki's quick start and straight into the Steam or GOG
                 download. One button per row: three side by side do not fit a phone in any language. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/launcher_empty_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/launcher_empty_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/launcher_empty_body"
                        android:textAppearance="?attr/textAppearanceBodyMedium"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/launcher_empty_quick_start_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/launcher_empty_quick_start"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/launcher_empty_download_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/steam_dl_menu"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/launcher_empty_gog_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gog_dl_menu"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Project Zomboid news (The Indie Stone's Steam announcements), filled by
                 LauncherFragment.showNews; hidden until there is something to show. -->
            <LinearLayout
                android:id="@+id/launcher_news_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/news_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <LinearLayout
                    android:id="@+id/launcher_news_items_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<!-- Single-player mod lists (ModsFragment): the top picks "New worlds" or a world, across all
     instances, and holds Sort and Import; below, a search field and one list - "Active" in load
     order, then "Inactive" by name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/mods_note"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mods_target"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <Spinner
        android:id="@+id/sp_mods_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tv_mods_game_running"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/mods_game_running"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_mods_unreadable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/mods_unreadable"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mods_sort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mods_sort"
            android:textSize="12sp" />

        <!-- Enable / disable every mod shown (all of them, or what the search leaves), for lists of
             a hundred mods and more. From RimDroid. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mods_enable_all"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/mods_enable_all"
            android:tooltipText="@string/mods_enable_all"
            app:icon="@drawable/ic_mods_enable_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mods_disable_all"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/mods_disable_all"
            android:tooltipText="@string/mods_disable_all"
            app:icon="@drawable/ic_mods_disable_all" />

        <!-- Export: pick mods, pack them into one ZIP in Downloads/zomdroid. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mods_export"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/mods_export"
            android:tooltipText="@string/mods_export"
            app:icon="@drawable/ic_mods_export" />
    </LinearLayout>

    <!-- Shown while picking mods to export, in place of the usual hint. -->
    <LinearLayout
        android:id="@+id/ll_mods_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_mods_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mods_select_all"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mods_select_all"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mods_select_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mods_export_go"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mods_export_go"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Import mods as a link under the buttons, like "Open Settings" on the Optimization page:
         as a second button its longer label made the two buttons different sizes. -->
    <TextView
        android:id="@+id/tv_mods_install"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/mods_open_import"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_mods_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="@string/mods_sort_hint"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_mods_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/mods_search"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_mods_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.7"
        android:text="@string/mods_empty"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mods"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>

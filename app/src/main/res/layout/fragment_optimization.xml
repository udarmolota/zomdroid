<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- JVM Args -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/optimization_group_jvm"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="@string/optimization_jvm_hint"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <!-- What is currently seeded by default (single source of truth:
                             LauncherPreferences.DEFAULT_JVM_ARGS, set from the fragment) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/optimization_jvm_recommended_label"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/optimization_jvm_recommended_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/optimization_jvm_4gb_note"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <TextView
                            android:id="@+id/optimization_open_settings_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/optimization_open_settings"
                            android:textSize="12sp"
                            android:textColor="?attr/colorPrimary"
                            android:background="?attr/selectableItemBackground"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"/>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BetterFPS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Collapsible header row -->
                    <LinearLayout
                        android:id="@+id/optimization_betterfps_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/optimization_group_betterfps"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"/>

                        <ImageButton
                            style="@style/AppTheme.ImageButton"
                            android:id="@+id/optimization_betterfps_help_ib"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:src="@drawable/mt_icon_help"/>

                        <ImageView
                            android:id="@+id/optimization_betterfps_expand_iv"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/mt_icon_expand_more"
                            android:scaleType="fitCenter"/>

                    </LinearLayout>

                    <!-- Collapsible content -->
                    <LinearLayout
                        android:id="@+id/optimization_betterfps_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/optimization_betterfps_hint"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/install_mod_group_instance"
                            android:textAppearance="?attr/textAppearanceBodySmall"/>

                        <Spinner
                            android:id="@+id/optimization_betterfps_instance_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/optimization_betterfps_mode_label"
                            android:textAppearance="?attr/textAppearanceBodySmall"/>

                        <Spinner
                            android:id="@+id/optimization_betterfps_mode_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/optimization_betterfps_file_label"
                            android:textAppearance="?attr/textAppearanceBodySmall"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <EditText
                                android:id="@+id/optimization_betterfps_path_et"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:hint="@string/game_instance_no_file_selected"
                                android:enabled="false"
                                android:focusable="false"
                                android:clickable="false"
                                android:cursorVisible="false"
                                android:inputType="none"/>

                            <ImageButton
                                style="@style/AppTheme.ImageButton"
                                android:id="@+id/optimization_betterfps_browse_ib"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/mt_icon_folder_open"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/optimization_betterfps_install_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:minWidth="160dp"
                            android:text="@string/optimization_install"/>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Render Less Zombie (B41) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Collapsible header row -->
                    <LinearLayout
                        android:id="@+id/optimization_rlz_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/optimization_group_rlz"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"/>

                        <ImageButton
                            style="@style/AppTheme.ImageButton"
                            android:id="@+id/optimization_rlz_help_ib"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:src="@drawable/mt_icon_help"/>

                        <ImageView
                            android:id="@+id/optimization_rlz_expand_iv"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/mt_icon_expand_more"
                            android:scaleType="fitCenter"/>

                    </LinearLayout>

                    <!-- Collapsible content -->
                    <LinearLayout
                        android:id="@+id/optimization_rlz_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/optimization_rlz_hint"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/install_mod_group_instance"
                            android:textAppearance="?attr/textAppearanceBodySmall"/>

                        <Spinner
                            android:id="@+id/optimization_rlz_instance_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/optimization_rlz_level_label"
                            android:textAppearance="?attr/textAppearanceBodySmall"/>

                        <Spinner
                            android:id="@+id/optimization_rlz_level_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/optimization_rlz_file_label"
                            android:textAppearance="?attr/textAppearanceBodySmall"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <EditText
                                android:id="@+id/optimization_rlz_path_et"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:hint="@string/game_instance_no_file_selected"
                                android:enabled="false"
                                android:focusable="false"
                                android:clickable="false"
                                android:cursorVisible="false"
                                android:inputType="none"/>

                            <ImageButton
                                style="@style/AppTheme.ImageButton"
                                android:id="@+id/optimization_rlz_browse_ib"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/mt_icon_folder_open"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/optimization_rlz_install_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:minWidth="160dp"
                            android:text="@string/optimization_install"/>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Every Texture Optimized -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Collapsible header row -->
                    <LinearLayout
                        android:id="@+id/optimization_eto_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/optimization_group_eto"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"/>

                        <ImageButton
                            style="@style/AppTheme.ImageButton"
                            android:id="@+id/optimization_eto_help_ib"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:src="@drawable/mt_icon_help"/>

                        <ImageView
                            android:id="@+id/optimization_eto_expand_iv"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/mt_icon_expand_more"
                            android:scaleType="fitCenter"/>

                    </LinearLayout>

                    <!-- Collapsible content -->
                    <LinearLayout
                        android:id="@+id/optimization_eto_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/optimization_eto_hint"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <Spinner
                            android:id="@+id/optimization_eto_instance_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <EditText
                                android:id="@+id/optimization_eto_path_et"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:hint="@string/game_instance_no_file_selected"
                                android:enabled="false"
                                android:focusable="false"
                                android:clickable="false"
                                android:cursorVisible="false"
                                android:inputType="none"/>

                            <ImageButton
                                style="@style/AppTheme.ImageButton"
                                android:id="@+id/optimization_eto_browse_ib"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/mt_icon_folder_open"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/optimization_eto_install_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:minWidth="160dp"
                            android:text="@string/optimization_install"/>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ZombieBuddy -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/optimization_zombiebuddy_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/optimization_group_zombiebuddy"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"/>

                        <ImageButton
                            style="@style/AppTheme.ImageButton"
                            android:id="@+id/optimization_zombiebuddy_help_ib"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:src="@drawable/mt_icon_help"/>

                        <ImageView
                            android:id="@+id/optimization_zombiebuddy_expand_iv"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/mt_icon_expand_more"
                            android:scaleType="fitCenter"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/optimization_zombiebuddy_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/optimization_zombiebuddy_hint"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <Spinner
                            android:id="@+id/optimization_zombiebuddy_instance_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"/>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/optimization_zombiebuddy_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:text="@string/optimization_zombiebuddy_enabled"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <EditText
                                android:id="@+id/optimization_zombiebuddy_path_et"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:hint="@string/game_instance_no_file_selected"
                                android:enabled="false"
                                android:focusable="false"
                                android:clickable="false"
                                android:cursorVisible="false"
                                android:inputType="none"/>

                            <ImageButton
                                style="@style/AppTheme.ImageButton"
                                android:id="@+id/optimization_zombiebuddy_browse_ib"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/mt_icon_folder_open"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/optimization_zombiebuddy_install_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:minWidth="160dp"
                            android:text="@string/optimization_install"/>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ZBBetterFPS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/optimization_zbbetterfps_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/optimization_group_zbbetterfps"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"/>

                        <ImageButton
                            style="@style/AppTheme.ImageButton"
                            android:id="@+id/optimization_zbbetterfps_help_ib"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:src="@drawable/mt_icon_help"/>

                        <ImageView
                            android:id="@+id/optimization_zbbetterfps_expand_iv"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/mt_icon_expand_more"
                            android:scaleType="fitCenter"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/optimization_zbbetterfps_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/optimization_zbbetterfps_hint"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <Spinner
                            android:id="@+id/optimization_zbbetterfps_instance_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/optimization_zbbetterfps_gl4es_warning_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/optimization_zbbetterfps_gl4es_warning"
                            android:textSize="11sp"
                            android:textColor="#FF6B6B"
                            android:visibility="gone"/>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <EditText
                                android:id="@+id/optimization_zbbetterfps_path_et"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:hint="@string/game_instance_no_file_selected"
                                android:enabled="false"
                                android:focusable="false"
                                android:clickable="false"
                                android:cursorVisible="false"
                                android:inputType="none"/>

                            <ImageButton
                                style="@style/AppTheme.ImageButton"
                                android:id="@+id/optimization_zbbetterfps_browse_ib"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/mt_icon_folder_open"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/optimization_zbbetterfps_install_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:minWidth="160dp"
                            android:text="@string/optimization_install"/>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Banner image -->
        <ImageView
            android:id="@+id/game_instance_item_banner_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/banner_build41"/>

        <!-- Dark gradient overlay bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/banner_gradient_overlay"/>

        <!-- Shown above the name while "Allow server hosting" is on: the game then runs on a
             separate profile, and this is the reminder that the usual saves are not gone. -->
        <TextView
            android:id="@+id/game_instance_item_hosting_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="44dp"
            android:text="@string/coop_hosting_badge"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:visibility="gone"
            tools:visibility="visible"/>

        <!-- Instance name bottom left -->
        <TextView
            android:id="@+id/game_instance_item_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            tools:text="Project Zomboid 41"/>

        <!-- Buttons bottom right -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <!-- Overflow first, then settings, then play: the destructive and the rarely used
                 sit furthest from the thumb, the action you came for is last. -->
            <ImageButton
                style="@style/AppTheme.ImageButton"
                android:id="@+id/game_instance_item_more_ib"
                android:contentDescription="@string/game_instance_manage_storage"
                android:src="@drawable/mt_icon_more_vert"
                android:tint="#FFFFFF"/>

            <ImageButton
                style="@style/AppTheme.ImageButton"
                android:id="@+id/game_instance_item_settings_ib"
                android:contentDescription="@string/game_instance_settings"
                android:src="@drawable/mt_icon_settings"
                android:tint="#FFFFFF"/>

            <ImageButton
                style="@style/AppTheme.ImageButton"
                android:id="@+id/game_instance_item_launch_ib"
                android:src="@drawable/mt_icon_play"
                android:tint="#FFFFFF"/>

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Toolbar" parent="">
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="colorControlNormal">?attr/colorOnSurface</item>
    </style>
    <style name="AppTheme.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@null</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>
    <style name="AppTheme.Button" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <!-- Caption under each icon in the drawer's bottom row. Single line and ellipsized: five
         columns share the drawer width, and a wrapped label would shove the row's height around. -->
    <style name="AppTheme.NavBottomLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="AppTheme.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bottom_nav_indicator</item>
    </style>

    <!-- Import / export screen (fragment_transfer.xml) -->
    <style name="AppTheme.TransferCard" parent="">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>
    <style name="AppTheme.TransferCardTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="AppTheme.TransferCardHint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="AppTheme.TransferButtonRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="AppTheme.TransferButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
    <style name="AppTheme.TransferButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="AppTheme.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="dividerColor">@color/pz_orange</item>
        <!-- Half the Material 3 side spacing (inset 12dp to 6dp, padding 28dp to 14dp): the longest
             drawer labels, like "Import/Export Custom Driver", were cut off at the old spacing. -->
        <item name="itemShapeInsetStart">6dp</item>
        <item name="itemShapeInsetEnd">6dp</item>
        <item name="itemHorizontalPadding">14dp</item>
        <item name="dividerInsetStart">14dp</item>
        <item name="dividerInsetEnd">14dp</item>
        <item name="subheaderInsetStart">14dp</item>
        <item name="subheaderInsetEnd">14dp</item>
        <!-- One step below the Material 3 drawer label (Label Large, 14sp): with the spacing
             above, the longest labels still did not fit. -->
        <item name="itemTextAppearance">@style/AppTheme.NavigationView.ItemText</item>
        <!-- Shorter rows (item height 48dp to 40dp, padding 4dp to 2dp): with the Mods item the
             drawer no longer fit a phone screen. -->
        <item name="itemVerticalPadding">2dp</item>
        <item name="materialThemeOverlay">@style/AppTheme.NavigationView.Overlay</item>
    </style>

    <style name="AppTheme.NavigationView.Overlay" parent="ThemeOverlay.Material3.NavigationView">
        <item name="listPreferredItemHeightSmall">40dp</item>
    </style>

    <style name="AppTheme.NavigationView.ItemText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
    </style>
</resources>
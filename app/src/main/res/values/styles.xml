<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Toolbar" parent="">
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="colorControlNormal">?attr/colorOnSurface</item>
    </style>
    <style name="AppTheme.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@null</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>
    <style name="AppTheme.Button" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <!-- Caption under each icon in the drawer's bottom row. Single line and ellipsized: five
         columns share the drawer width, and a wrapped label would shove the row's height around. -->
    <style name="AppTheme.NavBottomLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="AppTheme.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="dividerColor">@color/pz_orange</item>
        <!-- Half the Material 3 side spacing (inset 12dp to 6dp, padding 28dp to 14dp): the longest
             drawer labels, like "Import/Export Custom Driver", were cut off at the old spacing. -->
        <item name="itemShapeInsetStart">6dp</item>
        <item name="itemShapeInsetEnd">6dp</item>
        <item name="itemHorizontalPadding">14dp</item>
        <item name="dividerInsetStart">14dp</item>
        <item name="dividerInsetEnd">14dp</item>
        <item name="subheaderInsetStart">14dp</item>
        <item name="subheaderInsetEnd">14dp</item>
        <!-- One step below the Material 3 drawer label (Label Large, 14sp): with the spacing
             above, the longest labels still did not fit. -->
        <item name="itemTextAppearance">@style/AppTheme.NavigationView.ItemText</item>
    </style>

    <style name="AppTheme.NavigationView.ItemText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
    </style>
</resources>